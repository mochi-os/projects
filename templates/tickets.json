      {"id": "priority", "name": "Priority", "fieldtype": "enumerated", "required": 0, "card": 1, "rank": 3},
      {"id": "category", "name": "Category", "fieldtype": "enumerated", "required": 0, "card": 1, "rank": 4},
      {"id": "owner", "name": "Owner", "fieldtype": "user", "required": 0, "card": 0, "rank": 5},
